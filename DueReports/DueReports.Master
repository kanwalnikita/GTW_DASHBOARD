        <div class="container-fluid" style="background-color:#171503;height:20px;"></div>
      </div>
        <div class="container-lg"  style="height:100%;width:70%;margin-left:20%;margin-top:1%;" >
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
    <script type="text/javascript">
var normalNavigation = false;

document.addEventListener("click", function(event) {
    var element = event.target;
    while (element && element.tagName !== "A" && element.tagName !== "BUTTON" && element.tagName !== "INPUT") {
        element = element.parentElement;
    }
    if (element) normalNavigation = true;
}, true);

document.addEventListener("submit", function() {
    normalNavigation = true;
}, true);
        window.addEventListener("pagehide", function () {
            if (!normalNavigation) {
                navigator.sendBeacon('<%= ResolveUrl("~/EndSessionHandler.ashx") %>');
    }
});

    //     if (window.location.pathname.toLowerCase().indexOf("login.aspx") === -1) {
    //         setInterval(function () {
    //             fetch('<%= ResolveUrl("~/SessionCheck.ashx") %>', { credentials: "same-origin" })
    //         .then(function (r) { return r.json(); })
    //         .then(function (data) {
    //             if (!data.valid) {
    //                 window.location.href = '<%= ResolveUrl("~/Login.aspx") %>';
    //             }
    //         })
    //         .catch(function () { /* ignore transient network errors */ });
// }, 5000);
//     }
var path = window.location.pathname.toLowerCase();

// Pages that must work without being tied to a live "Username" session —
// entry points, admin-session-gated pages, and plain informational pages.
var sessionPollExcludedPages = [
    "login.aspx",
    "logout.aspx",
    "adminloginpage.aspx",
    "displayuserspage.aspx",
    "aboutus.aspx",
    "websitepage.aspx"
];

var skipSessionPoll = sessionPollExcludedPages.some(function(p) {
    return path.indexOf(p) !== -1;
});

if (!skipSessionPoll) {
    setInterval(function() {
        fetch('<%= ResolveUrl("~/SessionCheck.ashx") %>', { credentials: "same-origin" })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.valid) {
                    window.location.href = '<%= ResolveUrl("~/Login.aspx") %>';
                }
            })
            .catch(function() { });
    }, 5000);
} var path = window.location.pathname.toLowerCase();
// var skipSessionPoll = path.indexOf("login.aspx") !== -1 || path.indexOf("logout.aspx") !== -1;

// if (!skipSessionPoll) {
//     setInterval(function() {
//         fetch('<%= ResolveUrl("~/SessionCheck.ashx") %>', { credentials: "same-origin" })
//             .then(function(r) { return r.json(); })
//             .then(function(data) {
//                 if (!data.valid) {
//                     window.location.href = '<%= ResolveUrl("~/Login.aspx") %>';
//                 }
//             })
//             .catch(function() { });
//     }, 5000);
// }

    </script>
