      <style>  
     body {
         max-height:100%;
         background-color: #F8F8F8;
         font-family:"Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
     }
     
.main-head{
    height: 150px;
    background: #FFF;
   
}

.sidenav {
    height: 100%;
    background-color: #000;
    overflow-x: hidden;
    padding-top: 20px;
}


.main {
    padding: 0px 10px;
}

@media screen and (max-height: 450px) {
    .sidenav {padding-top: 15px;}
}

@media screen and (max-width: 450px) {
    .login-form{
        margin-top: 10%;
    }

    .register-form{
        margin-top: 10%;
    }
}

@media screen and (min-width: 768px){
    .main{
        margin-left: 27%; 
    }

    .sidenav{
        width: 15%;
        position: fixed;
        z-index: 1;
        top: 0;
        left: 0;
    }

    .login-form{
        
        margin-top: 80%;
    }

    .register-form{
        margin-top: 20%;
    }

}
 
.sidenav a {
  padding: 6px 15px 15px 16px;
  text-decoration: none;
  font-size: 20px;
   color: aquamarine;
   background-color: #37373f;
  display: block;
  text-align:center;
}

        .sidenav a:hover {
            color: aquamarine;
        }
       
 
.login-main-text{
    margin-top: 2%;
    padding: 10px;
}

.login-main-text h2{
    font-weight: 300;
}

.btn-black{
    background-color: #000 !important;
    color: #fff;
}
.sideitem{
    margin-top: 45%;
    background-color: #37373f;
}
     #a1{
         background-color:#37373f;  
         border: 0px;
         border-bottom-style: groove;
     }
     #a2{
         background-color:#37373f;  
         border: 0px;
         border-bottom-style: groove;
     }
      #a3{
         background-color:#37373f;  
         border: 0px;
         border-bottom-style: groove;
     }
      #a4{
         background-color:#37373f;  
         border: 0px;
         border-bottom-style: groove;

      }
      #a5{
         background-color:#37373f;  
         border: 0px;
         border-bottom-style: groove;
         color: #66e699;

      }
      #a2:after,#a1:after,#a3:after,#a4:after,#a5:after {
  display:block;
  content: '';
  border-bottom: solid 3px #019fb6;  
  transform: scaleX(0);  
  transition: transform 0.75s ease-out;
  text-decoration: none;
}
          
      #a2:visited, #a1:visited, #a3:visited, #a4:visited,#a5:visited {
  text-decoration: none;    
      }

     
   #a2:hover:after,#a1:hover:after,#a3:hover:after,#a4:hover:after,#a5:hover:after { transform: scaleX(1); }
  
     
     #heading{
        text-align:left;
        margin-left:15%;
         padding-top:3%;
         padding-bottom:3%;
     }
        .auto-style2 {
            width: 100%;
            padding-right: 15px;
            padding-left: 15px;
            margin-right: auto;
            margin-left: auto;
            height: 10%;
        }
        .auto-style3 {
            width: 655px;
            font-family:Verdana;
        }
        .auto-style4 {
            width: 98%;
            max-width: 1140px;
            min-width: 992px;
            margin-left: 20px;
            margin-right: auto;
            padding-left: 15px;
            padding-right: 15px;
        }
        .btnsend{
            border:0.5px solid black;
            background-color:#A0E4CB;
            font-family:Verdana;
            border-radius:0px;
            box-shadow: 5px 0px 8px #888888;

        }
        .btnsend:hover{
            
            background-color:#5F8D4E;
        }
    
          .Spaceline {
              width: 100%;
              height: 20px;
              margin-left: auto;
              margin-right: auto;
              padding-left: 15px;
              padding-right: 15px;
          }
    .developed-by {
    background-color: lightyellow; /* Dark background for the box */
    color:#37373f; /* White text */
    border-radius: 5px; /* Rounded corners */
    padding: 10px;
    position: absolute; /* Positioning it in the corner */
    right: 90px; /* Adjust as needed */
    top: 15px; /* Adjust as needed */
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3); /* Optional shadow */
    font-size: 10pt;
    height: 80px;
    text-align:center;
    font-weight: bold;
    vertical-align: top;
    border: 1px solid black;
}
